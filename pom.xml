<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.owl24.apm</groupId>
    <artifactId>owl24-java</artifactId>
    <version>0.1.4</version>
    <packaging>jar</packaging>

    <name>owl24-java</name>
    <description>Java SDK for owl24 - one line of code to send logs, traces, and metrics to your owl24 dashboard, built on OpenTelemetry.</description>
    <url>https://owl24.dev</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/Madnands5/owl24/blob/main/packages/owl24-java/LICENSE</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Madnands5</name>
            <url>https://github.com/Madnands5</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Madnands5/owl24.git</connection>
        <developerConnection>scm:git:https://github.com/Madnands5/owl24.git</developerConnection>
        <url>https://github.com/Madnands5/owl24</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.46.0</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>1.46.0</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <version>1.46.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <!--
          Optional: only used to bridge SLF4J/Logback log events (e.g. Spring
          Boot's default logging, which never touches System.out and so is
          invisible to setupConsoleBridge()) into the owl24 logger. Marked
          optional so it isn't forced onto consumers that don't already have
          Logback on their classpath - Owl24LogbackAppender.tryInstall()
          degrades to a no-op (NoClassDefFoundError, caught) when it's
          absent. Consumers that do have Logback (virtually all default
          Spring Boot apps) get their own Logback version at runtime anyway,
          since this is optional rather than a forced transitive dependency.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.14</version>
            <optional>true</optional>
        </dependency>
        <!--
          JVM runtime metrics (CPU/memory/GC/threads/classes) - the Java
          equivalent of owl24-js's @opentelemetry/host-metrics. Pinned to
          2.12.0-alpha specifically because that's the instrumentation
          release that targets SDK 1.46.0 (matching the other otel deps
          above) - confirmed against the project's own release notes, not
          assumed. Still "-alpha" upstream (this artifact has never had a
          stable release; @opentelemetry/host-metrics is equally pre-1.0 in
          the JS ecosystem's own versioning), and this version predates the
          unified RuntimeMetrics facade class - confirmed directly from the
          jar's contents, not docs (which describe a later API) - hence
          registering each of Classes/Cpu/GarbageCollector/MemoryPools/
          Threads individually in Owl24.java instead of one RuntimeMetrics
          call.
        -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-runtime-telemetry-java8</artifactId>
            <version>2.12.0-alpha</version>
        </dependency>

        <!--
          Library (agent-free) JDBC instrumentation - what
          Owl24.instrumentDataSource() wraps a DataSource with to produce
          db.system-tagged spans for Owl24DbMetricsSpanProcessor to derive
          db.query.* metrics from. Pinned to the same 2.12.0-alpha release
          train as opentelemetry-runtime-telemetry-java8 above, for the same
          reason: that's the instrumentation release verified to target this
          SDK's OTel 1.46.0.
        -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-jdbc</artifactId>
            <version>2.12.0-alpha</version>
        </dependency>
        <!--
          opentelemetry-jdbc:2.12.0-alpha's own POM requires
          opentelemetry-instrumentation-api:2.12.0 (that's where
          ServerAttributesGetter, needed by JdbcTelemetry.create(...).build(),
          actually lives - confirmed by inspecting both artifacts' jars
          directly; io.micrometer:micrometer-tracing-bridge-otel is a
          same-name red herring, not the actual dependency owl24-java's
          Owl24DbMetricsSpanProcessor/instrumentDataSource path needs). Left
          undeclared, this is only a transitive dependency of opentelemetry-
          jdbc - and any consumer whose own classpath pulls an older
          instrumentation-api transitively from elsewhere (verified live:
          Spring's micrometer-tracing-bridge-otel pulls 1.33.3, which
          predates that class) can have Maven's nearest-wins mediation
          downgrade it there, causing Owl24.instrumentDataSource() to fail
          with NoClassDefFoundError at DataSource-bean construction time
          even though `mvn compile` on owl24-java itself never notices
          (nothing in owl24-java's own source references that class
          directly - only opentelemetry-jdbc's internals do, at runtime).
          Declaring it directly here - not just left to opentelemetry-jdbc's
          transitive pull - makes owl24-java self-contained: any consumer
          now gets a working version regardless of what else on their
          classpath would otherwise win mediation.
        -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-instrumentation-api</artifactId>
            <version>2.12.0</version>
        </dependency>

        <!--
          Mandatory (not optional, unlike logback-classic above): lets
          Owl24SpringAutoConfiguration wire real per-request tracing into
          any Spring Boot host app with zero manual bean code - Spring MVC
          never creates a span at all without this bridge on the classpath.
          Every owl24-java consumer pulls these transitively, even non-Spring
          ones (e.g. the JDK HttpServer demo) - a deliberate tradeoff to keep
          this a single published artifact instead of a second
          owl24-java-spring-boot-starter module; the auto-configuration
          class itself is harmless dead weight on a classpath with no Spring
          ApplicationContext to register it into.

          Versions pinned explicitly (this pom has no spring-boot-starter-
          parent to manage them) to the combination verified working against
          this SDK's OTel 1.46.0 in clientservers/java-springboot-server.
          Consumers that DO use spring-boot-starter-parent will have its own
          inherited dependencyManagement override these io.opentelemetry:*
          versions regardless of what's declared here (Maven's
          dependencyManagement always wins over plain transitive depth) -
          see that demo's pom.xml for the opentelemetry-bom/semconv pin
          needed to avoid a NoClassDefFoundError from the resulting clash.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>3.3.5</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
            <version>1.3.5</version>
        </dependency>

        <!--
          Task 12 (todolist.md, added 2026-08-23) - no test dependencies or
          Surefire were configured at all before this. Test-scoped, so a
          consumer of the published owl24-java artifact never pulls this in.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <plugins>
            <!--
              Task 12 (todolist.md, added 2026-08-23) - explicit version
              pin since this pom has no parent managing plugin versions;
              `mvn test` was previously a no-op (no test dependencies, no
              Surefire config at all).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!-- Coverage reporting (Task 12) - `mvn test jacoco:report`, output in target/site/jacoco/. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Central Portal publishing (replaces the old OSSRH/nexus-staging
              flow, which Sonatype sunset - any namespace registered now goes
              through central.sonatype.com directly). `extensions=true` is
              required so this plugin can bind to the deploy phase.
              publishingServerId must match a <server> id in ~/.m2/settings.xml
              whose username/password are your Central Portal user token
              (Account -> Generate User Token on central.sonatype.com), not
              your login password.
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.7.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>

            <!-- Central requires GPG-signed artifacts (jar, sources, javadoc, pom). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <configuration>
                    <!--
                      Pinned explicitly: the gpg.exe bundled with Git for
                      Windows reports its version as "2.4.7-unknown", and
                      this plugin's version-detection regex can't parse the
                      "-unknown" suffix, failing every sign with
                      "Could not determine gpg version" - confirmed live
                      2026-07-25. The official standalone GnuPG install
                      (winget id GnuPG.GnuPG) reports a clean "2.5.21" with
                      no suffix and works. Pointed here explicitly rather
                      than relying on PATH order between the two installs.
                    -->
                    <executable>C:\Program Files\GnuPG\bin\gpg.exe</executable>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Central requires a sources jar alongside the main jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Central requires a javadoc jar alongside the main jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>